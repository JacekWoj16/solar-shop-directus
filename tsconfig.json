{
  "compilerOptions": {
    "target": "ES2022",
    // "dom" is here for tests/cart.store.test.ts, which runs under jsdom and
    // touches window.localStorage. The rest of the suite is DOM-free.
    "lib": ["ES2022", "dom"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./storefront/src/*"]
    }
  },
  "include": ["tests/**/*.ts", "vitest.config.ts"]
}
