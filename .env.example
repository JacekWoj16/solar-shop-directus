# ---------------------------------------------------------------------------
# Copy to .env and adjust. Every value below has a working development default
# in docker-compose.yml, so .env is optional for local work and required for
# any real deployment.
# ---------------------------------------------------------------------------

# --- PostgreSQL (consumed by both postgres and directus services) ---
DB_DATABASE=solar_shop
DB_USER=solar_shop
DB_PASSWORD=solar_shop_dev

# --- Directus ---
DIRECTUS_PORT=8055
# Generate with: openssl rand -base64 32
DIRECTUS_SECRET=dev-only-secret-replace-in-production
DIRECTUS_PUBLIC_URL=http://localhost:8055
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=admin123
DIRECTUS_CORS_ORIGIN=http://localhost:3000

# --- Seed script (directus/seed) ---
# Static admin token created in Directus: User Directory -> admin -> Token.
DIRECTUS_URL=http://localhost:8055
DIRECTUS_ADMIN_TOKEN=

# --- Storefront (storefront/.env.local) ---
# Server-side base URL used by React Server Components.
DIRECTUS_URL=http://localhost:8055
# Browser-visible base URL; identical in local dev, different behind a proxy.
NEXT_PUBLIC_DIRECTUS_URL=http://localhost:8055
# Server-only token with create rights on orders/order_items. Never NEXT_PUBLIC_.
DIRECTUS_STATIC_TOKEN=
# Absolute origin of the storefront, used for canonical URLs and PDF links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
